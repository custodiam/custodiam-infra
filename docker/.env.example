# docker/.env.example
# Copia este archivo a .env y rellena los valores
# ⚠️ NO SUBIR A GIT

# ============ BASE DE DATOS ============
POSTGRES_USER=custodiam
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_DB=custodiam
KEYCLOAK_DB=custodiam_kc

# ============ KEYCLOAK ADMIN ============
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# ============ CLOUDFLARE (opcional para dev local) ============
# CLOUDFLARE_TUNNEL_TOKEN=

# ============ FIREBASE (opcional) ============
# FIREBASE_CREDENTIALS=

# ============ N8N (opcional, post-MVP) ============
# N8N_USER=admin
# N8N_PASSWORD=CAMBIAR_PASSWORD_N8N

# ============ DOMINIO ============
DOMAIN=localhost

# ============ VERSIONES ============
API_VERSION=latest
APP_VERSION=latest

# ============ BREVO SMTP (Keycloak emails transaccionales) ============
# Decisión arquitectónica: ADR-021. Implementación operativa: EN-08-30 + guía
# 10 §Paso 2.7. realm-custodiam.json resuelve estas variables en arranque via
# placeholders ${env.KEYCLOAK_SMTP_USERNAME} y ${env.KEYCLOAK_SMTP_PASSWORD}.
#
# Obtener:
#   1. Cuenta Brevo verificando dominio custodiam.es (DKIM/SPF/DMARC).
#   2. SMTP & API → SMTP Keys → Generar nueva clave (variante "Estándar").
#
# ⚠️ IMPORTANTE: KEYCLOAK_SMTP_USERNAME NO es el email de tu cuenta web de
# Brevo. Es el "SMTP login" que aparece en SMTP & API → "Tu configuración
# SMTP" → "Iniciar sesión": un identificador con formato acXXXXXXX@smtp-
# brevo.com asignado por Brevo a cada cuenta. Si pones tu email de login
# web, Brevo responde 535 5.7.8 Authentication failed.
#
# En equipos del proyecto los valores reales viven cifrados en .env.sops; aquí
# se mantienen vacíos como referencia y para que dev-up.sh con fallback .env
# plano arranque sin error (Keycloak emitirá los emails que fallarán en SMTP,
# pero el resto del stack no se ve afectado).
KEYCLOAK_SMTP_USERNAME=
KEYCLOAK_SMTP_PASSWORD=

# ============ MOCK OIDC (TESTING) ============
# URL del servicio mock-oauth2-server (opt-in bajo --profile test).
# La consume custodiam-app para correr los tests sin UI contra un IdP
# controlado (ver guía 22 §5). No la usa el runtime real.
# Arrancar el servicio:
#   docker compose --profile test up -d mock-oidc
# Correr los tests Dart consumiendo esta variable:
#   MOCK_OIDC_URL=http://localhost:8888 flutter test test/infrastructure/auth/
# MOCK_OIDC_URL=http://localhost:8888
