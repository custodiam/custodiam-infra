# docker/.env.example
# Copia este archivo a .env y rellena los valores
# ⚠️ NO SUBIR A GIT

# ============ BASE DE DATOS ============
POSTGRES_USER=custodiam
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_DB=custodiam
KEYCLOAK_DB=custodiam_kc

# ============ KEYCLOAK ADMIN ============
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# ============ CLOUDFLARE (opcional para dev local) ============
# CLOUDFLARE_TUNNEL_TOKEN=

# ============ FIREBASE (opcional) ============
# FIREBASE_CREDENTIALS=

# ============ N8N (opcional, post-MVP) ============
# N8N_USER=admin
# N8N_PASSWORD=CAMBIAR_PASSWORD_N8N

# ============ DOMINIO ============
DOMAIN=localhost

# ============ VERSIONES ============
API_VERSION=latest
APP_VERSION=latest

# ============ RESEND SMTP (Keycloak emails transaccionales) ============
# Decisión arquitectónica: ADR-021 (Brevo → Resend evolution). Implementación
# operativa: EN-08-30 + guía 10 §Paso 2.7. realm-custodiam.json resuelve estas
# variables en arranque via placeholders ${env.KEYCLOAK_SMTP_USERNAME} y
# ${env.KEYCLOAK_SMTP_PASSWORD}.
#
# Obtener:
#   1. Cuenta en https://resend.com (free tier 3000/mes, sin tarjeta).
#   2. Domains → Add Domain custodiam.es → verificar 3 DNS records (DKIM
#      resend._domainkey + MX send + TXT SPF send). Click/open tracking
#      vienen DESACTIVADOS por defecto (motivo del cambio desde Brevo).
#   3. API Keys → Create con permission "Sending access" y domain restriction
#      a custodiam.es. La key empieza por re_...
#
# Convención Resend: KEYCLOAK_SMTP_USERNAME es literal "resend" (no un email);
# KEYCLOAK_SMTP_PASSWORD es la API key generada arriba. Host fijado en el
# realm json a smtp.resend.com:587 STARTTLS.
#
# En equipos del proyecto los valores reales viven cifrados en .env.sops; aquí
# se mantienen vacíos como referencia y para que dev-up.sh con fallback .env
# plano arranque sin error (Keycloak emitirá los emails que fallarán en SMTP,
# pero el resto del stack no se ve afectado).
KEYCLOAK_SMTP_USERNAME=
KEYCLOAK_SMTP_PASSWORD=

# ============ MOCK OIDC (TESTING) ============
# URL del servicio mock-oauth2-server (opt-in bajo --profile test).
# La consume custodiam-app para correr los tests sin UI contra un IdP
# controlado (ver guía 22 §5). No la usa el runtime real.
# Arrancar el servicio:
#   docker compose --profile test up -d mock-oidc
# Correr los tests Dart consumiendo esta variable:
#   MOCK_OIDC_URL=http://localhost:8888 flutter test test/infrastructure/auth/
# MOCK_OIDC_URL=http://localhost:8888
