# docker/.env.example
# Copia este archivo a .env y rellena los valores
# ⚠️ NO SUBIR A GIT

# ============ BASE DE DATOS ============
POSTGRES_USER=custodiam
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_DB=custodiam
KEYCLOAK_DB=custodiam_kc

# ============ KEYCLOAK ADMIN ============
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# ============ CLOUDFLARE (opcional para dev local) ============
# CLOUDFLARE_TUNNEL_TOKEN=

# ============ FIREBASE (opcional) ============
# FIREBASE_CREDENTIALS=

# ============ N8N (opcional, post-MVP) ============
# N8N_USER=admin
# N8N_PASSWORD=CAMBIAR_PASSWORD_N8N

# ============ DOMINIO ============
DOMAIN=localhost

# ============ VERSIONES ============
API_VERSION=latest
APP_VERSION=latest

# ============ MOCK OIDC (TESTING) ============
# URL del servicio mock-oauth2-server (opt-in bajo --profile test).
# La consume custodiam-app para correr los tests sin UI contra un IdP
# controlado (ver guía 22 §5). No la usa el runtime real.
# Arrancar el servicio:
#   docker compose --profile test up -d mock-oidc
# Correr los tests Dart consumiendo esta variable:
#   MOCK_OIDC_URL=http://localhost:8888 flutter test test/infrastructure/auth/
# MOCK_OIDC_URL=http://localhost:8888
